rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function gestor() {
      return request.auth != null && request.auth.token.email == 'vaniaoliveirasilva@professor.educacao.sp.gov.br';
    }
    function autenticado() { return request.auth != null; }
    function senhaRecente() { return gestor() && request.auth.token.auth_time is int && request.time.toMillis() / 1000 - request.auth.token.auth_time < 300; }
    function votacaoAberta() { return exists(/databases/$(database)/documents/config/eleicao) && get(/databases/$(database)/documents/config/eleicao).data.get('votingOpen', false) == true && !encerrada(); }
    function encerrada() {
      return exists(/databases/$(database)/documents/config/eleicao)
        && get(/databases/$(database)/documents/config/eleicao).data.get('closed', false) == true;
    }
    function sessaoAtiva(ra) {
      return resource.data.get('urnaAtiva', '') is string
        && resource.data.get('urnaAtiva', '') != ''
        && exists(/databases/$(database)/documents/urnas/$(resource.data.urnaAtiva))
        && get(/databases/$(database)/documents/urnas/$(resource.data.urnaAtiva)).data.status == 'liberada'
        && get(/databases/$(database)/documents/urnas/$(resource.data.urnaAtiva)).data.ra == ra;
    }
    match /config/{doc} {
      allow read: if true;
      allow create: if gestor() && doc != 'resultadoPublico';
      allow update: if doc == 'eleicao' && gestor() && (
        (resource.data.get('closed', false) != true && request.resource.data.get('closed', false) != true && request.resource.data.get('resultsReleased', false) != true)
        ||
        (resource.data.get('closed', false) != true && request.resource.data.get('closed', false) == true && senhaRecente() && request.resource.data.get('votingOpen', false) == false && request.resource.data.get('registrationOpen', false) == false && request.resource.data.get('resultsReleased', false) == false)
        ||
        (resource.data.get('closed', false) == true && request.resource.data.get('closed', false) == true && request.resource.data.get('votingOpen', false) == false && request.resource.data.get('registrationOpen', false) == false && resource.data.get('resultsReleased', false) == false && request.resource.data.get('resultsReleased', false) == true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resultsReleased']))
      ) || (doc == 'resultadoPublico' && gestor() && encerrada() && !get(/databases/$(database)/documents/config/eleicao).data.get('resultsReleased', false))
        || (doc != 'eleicao' && doc != 'resultadoPublico' && gestor());
      allow create: if doc == 'resultadoPublico' && gestor() && encerrada() && !get(/databases/$(database)/documents/config/eleicao).data.get('resultsReleased', false);
      allow delete: if false;
    }
    match /candidaturas/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if gestor();
    }
    match /eleitores/{ra} {
      allow get: if gestor() || (autenticado() && sessaoAtiva(ra));
      allow list: if gestor();
      allow create, delete: if gestor();
      allow update: if gestor() || (
        !encerrada() &&
        autenticado() && sessaoAtiva(ra)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votedCargos', 'lastVoteAt'])
        && request.resource.data.votedCargos is list
        && resource.data.get('votedCargos', []) is list
        && request.resource.data.votedCargos.size() == resource.data.get('votedCargos', []).size() + 1
        && request.resource.data.votedCargos.hasAll(resource.data.get('votedCargos', []))
      );
    }
    match /urnas/{urnaId} {
      allow read: if true;
      allow create, update, delete: if gestor();
    }
    match /votos/{id} {
      allow create: if autenticado() && votacaoAberta()
        && request.resource.data.keys().hasOnly(['tipo','candidatoId','candidatoNome','numero','cargo','createdAt'])
        && request.resource.data.tipo in ['valido','branco','nulo']
        && request.resource.data.cargo is string
        && request.resource.data.cargo.size() > 0
        && !('ra' in request.resource.data)
        && !('nome' in request.resource.data)
        && !('turma' in request.resource.data);
      allow read: if gestor();
      allow update, delete: if false;
    }
  }
}
